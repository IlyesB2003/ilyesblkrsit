      <!-- PAGE 4 -->
      <div class="page" id="p4">
        <span class="eyebrow">الخطوة 4 من 5</span>
        <div class="progress-wrap">
          <div class="progress-top">
            <div class="pct" id="pctText">0<small>%</small></div>
            <div class="msg" id="progMsg">جارٍ بدء المثبّت...</div>
            <div class="detail" id="progDetail">يتم تجهيز خطة التثبيت</div>
          </div>
          <div class="bar"><div class="bar-inner" id="barInner"></div></div>
        </div>
        <div class="twocol">
          <div class="col"><div class="panel"><h4>المهام</h4><div class="tasklist" id="taskList"></div></div></div>
          <div class="col"><div class="panel"><h4>آخر الأحداث</h4><div class="log" id="logBox">...</div></div></div>
        </div>
        <div class="progress-note">لا تغلق هذه النافذة أثناء التثبيت. قد يستغرق وقتاً طويلاً حسب سرعة الإنترنت. <a class="cancel-link" onclick="cancelInstall()">إلغاء التثبيت</a></div>
      </div>

      <!-- PAGE 5 -->
      <div class="page" id="p5">
        <div class="center">
          <div class="finish-icon">✓</div>
          <h2 class="finish-title">اكتمل النقل بنجاح</h2>
          <p class="finish-sub">تم تجهيز بيئة الذكاء الاصطناعي على ويندوز. أعد تشغيل الجهاز مرة واحدة حتى تظهر أوامر PATH وJAVA_HOME في كل التطبيقات.</p>
        </div>
        <div class="result-cards">
          <div class="result-card"><div class="result-inner"><b id="doneModels">0</b><span>نماذج جاهزة</span></div></div>
          <div class="result-card"><div class="result-inner"><b id="doneTools">0</b><span>أدوات ولغات</span></div></div>
          <div class="result-card"><div class="result-inner"><b id="doneMcp">0</b><span>خوادم MCP</span></div></div>
          <div class="result-card"><div class="result-inner"><b id="doneVerified">0</b><span>لغات تعمل فعلياً</span></div></div>
        </div>
        <div class="warnbox hidden" id="finishWarn">توجد بعض التنبيهات. افتح «تقرير الفحص» لترى ما لم يكتمل، ثم أعد تشغيل ويندوز وشغّل المثبّت مرة ثانية: سيتخطّى ما ثُبّت ويعيد محاولة الباقي.</div>
        <div class="pathbox" id="finishPath">%LOCALAPPDATA%\AI-Dev-Transfer</div>
        <div class="center" style="margin-top:12px;">
          <button class="btn ghost small" onclick="openFolder()">فتح مجلد التثبيت</button>
          <button class="btn ghost small" onclick="openLog()">فتح السجل</button>
          <button class="btn primary small" onclick="openReport()">تقرير الفحص</button>
        </div>
      </div>

      <!-- PAGE 6 -->
      <div class="page" id="p6">
        <div class="center">
          <div class="finish-icon err">!</div>
          <h2 class="finish-title">توقف التثبيت</h2>
          <p class="finish-sub" id="errMsg">حدث خطأ غير متوقع.</p>
        </div>
        <div class="pathbox" id="errPath">%LOCALAPPDATA%\AI-Dev-Transfer\logs</div>
        <div class="center">
          <button class="btn ghost small" onclick="openLog()">فتح السجل</button>
          <button class="btn primary small" onclick="closeWizard()">إغلاق</button>
        </div>
        <div class="warnbox" style="margin-top:14px;">نصيحة: تأكد من اتصال الإنترنت، ومن أن لديك مساحة كافية، ثم أعد تشغيل المثبّت. يمكنك إلغاء تحديد بعض النماذج لتقليل الحجم.</div>
      </div>
    </div>

    <div class="footer" id="footer">
      <div class="back"><button class="btn ghost" id="btnBack" onclick="backPage()">السابق</button></div>
      <div class="actions">
        <span class="hint" id="footerHint">لا شيء يُثبَّت قبل موافقتك</span>
        <button class="btn primary" id="btnNext" onclick="nextPage()">التالي</button>
      </div>
    </div>
  </div>
</div>

<script language="javascript">
var current = 1;
var rootPath = "";
var scriptDir = "";
var statusPath = "";
var planPath = "";
var logPath = "";
var pollTimer = null;
var started = false;
var finished = false;
var lastStatus = null;
var noStatusTicks = 0;

function sh() { return new ActiveXObject("WScript.Shell"); }
function fso() { return new ActiveXObject("Scripting.FileSystemObject"); }

function init() {
    try {
        window.resizeTo(980, 680);
        window.moveTo(Math.max(0, (screen.availWidth - 980) / 2), Math.max(0, (screen.availHeight - 680) / 2));
    } catch (e) {}
    rootPath = sh().ExpandEnvironmentStrings("%LOCALAPPDATA%") + "\\AI-Dev-Transfer";
    var href = unescape(location.pathname);
    if (href.indexOf("file:///") == 0) href = href.substring(8);
    href = href.replace(/\//g, "\\");
    if (href.charAt(0) == "\\" && href.charAt(2) == ":") href = href.substring(1);
    scriptDir = href.substring(0, href.lastIndexOf("\\"));
    statusPath = rootPath + "\\status.json";
    planPath = rootPath + "\\plan.json";
    logPath = rootPath + "\\logs";
    try {
        var on = navigator.onLine;
        document.getElementById("netDot").className = on ? "online" : "online off";
        document.getElementById("netText").innerHTML = on ? "متصل" : "غير متصل";
    } catch (e) {}
    calc();
    showPage(1);
    checkAutoTest();
}

/* Automated test mode (used only by the GitHub Actions Windows test).
   It is enabled only when %LOCALAPPDATA%\AI-Dev-Transfer\autotest.txt exists;
   the file is deleted as soon as it is read, so normal users never see it. */
function checkAutoTest() {
    var p = rootPath + "\\autotest.txt";
    try {
        if (!fso().FileExists(p)) return;
        var f = fso().OpenTextFile(p, 1, false, 0);
        var list = f.AtEndOfStream ? "" : f.ReadAll();
        f.Close();
        fso().DeleteFile(p);
        autoTest(list.replace(/^\s+|\s+$/g, ""));
    } catch (e) {}
}

function autoTest(list) {
    window.alert = function () {};
    window.confirm = function () { return true; };
    setTimeout(function () { nextPage(); }, 5000);
    setTimeout(function () {
        document.getElementById("acceptChk").checked = true;
        updateNav();
    }, 9000);
    setTimeout(function () { nextPage(); }, 12000);
    setTimeout(function () {
        if (list) {
            var want = "," + list + ",";
            var boxes = document.querySelectorAll(".comp");
            for (var i = 0; i < boxes.length; i++) {
                if (boxes[i].value == "ollama") { boxes[i].checked = want.indexOf(",ollama,") >= 0; }
            }
            toggleModels();
            for (var j = 0; j < boxes.length; j++) {
                if (!boxes[j].disabled) boxes[j].checked = want.indexOf("," + boxes[j].value + ",") >= 0;
            }
            calc();
        }
    }, 15000);
    setTimeout(function () { nextPage(); }, 19000);
}

function showPage(n) {
    current = n;
    for (var i = 1; i <= 6; i++) {
        var el = document.getElementById("p" + i);
        if (el) el.className = (i == n) ? "page active" : "page";
    }
    var titles = ["نظرة عامة", "الموافقة", "اختيار المكونات", "جارٍ التثبيت", "تم بنجاح", "توقف التثبيت"];
    document.getElementById("topTitle").innerHTML = titles[n - 1];
    updateSteps(n);
    var footer = document.getElementById("footer");
    footer.className = (n >= 4) ? "footer hidden" : "footer";
    updateNav();
}

function updateSteps(n) {
    for (var i = 1; i <= 5; i++) {
        var el = document.getElementById("s" + i);
        if (!el) continue;
        if (n == 6) {
            el.className = (i < 4) ? "step done" : "step";
        } else if (i < n) {
            el.className = "step done";
        } else if (i == n) {
            el.className = "step active";
        } else {
            el.className = "step";
        }
    }
}

function updateNav() {
    var back = document.getElementById("btnBack");
    var next = document.getElementById("btnNext");
    var hint = document.getElementById("footerHint");
    if (current == 1) {
        back.className = "btn ghost hidden";
        next.className = "btn primary";
        next.innerHTML = "التالي";
        next.disabled = false;
        hint.innerHTML = "لا شيء يُثبَّت قبل موافقتك";
    } else if (current == 2) {
        back.className = "btn ghost";
        next.className = "btn primary";
        next.innerHTML = "أوافق وأكمل";
        next.disabled = !document.getElementById("acceptChk").checked;
        hint.innerHTML = "اقرأ الشروط ثم وافق للمتابعة";
    } else if (current == 3) {
        back.className = "btn ghost";
        next.className = "btn primary";
        next.innerHTML = "تثبيت الآن";
        next.disabled = false;
        hint.innerHTML = "سيبدأ التنزيل فور الضغط";
    }
}

function nextPage() {
    if (current == 1) { showPage(2); return; }
    if (current == 2) {
        if (!document.getElementById("acceptChk").checked) { alert("يجب الموافقة على الشروط أولاً."); return; }
        showPage(3); return;
    }
    if (current == 3) { startInstall(); return; }
}

function backPage() {
    if (current == 2) { showPage(1); return; }
    if (current == 3) { showPage(2); return; }
}

function selectGroup(group, value) {
    var boxes = document.querySelectorAll(".comp[data-group='" + group + "']");
    for (var i = 0; i < boxes.length; i++) {
        if (!boxes[i].disabled) boxes[i].checked = value;
    }
    calc();
}

function toggleModels() {
    var ollama = null;
    var all = document.querySelectorAll(".comp");
    for (var i = 0; i < all.length; i++) { if (all[i].value == "ollama") ollama = all[i]; }
    if (!ollama) return;
    var models = document.querySelectorAll(".modelbox");
    for (var j = 0; j < models.length; j++) {
        if (!ollama.checked) {
            models[j].checked = false;
            models[j].disabled = true;
        } else {
            models[j].disabled = false;
        }
    }
    calc();
}

function calc() {
    var boxes = document.querySelectorAll(".comp");
    var mb = 0;
    var models = 0;
    for (var i = 0; i < boxes.length; i++) {
        if (boxes[i].checked) {
            mb += parseInt(boxes[i].getAttribute("data-size"), 10) || 0;
            if (boxes[i].getAttribute("data-group") == "models") models++;
        }
    }
    var gb = mb / 1024;
    var txt = gb >= 1 ? (Math.round(gb * 10) / 10) + " GB" : Math.round(mb) + " MB";
    var el = document.getElementById("totalSize");
    if (el) el.innerHTML = txt;
    var info = document.getElementById("diskInfo");
    if (info) {
        try {
            var free = fso().GetDrive("C").FreeSpace / (1024 * 1024 * 1024);
            var freeTxt = Math.round(free * 10) / 10;
            if (free < gb + 4) {
                info.innerHTML = "· المساحة الحرة " + freeTxt + " GB — قد لا تكفي";
                info.className = "warn";
            } else {
                info.innerHTML = "· المساحة الحرة " + freeTxt + " GB · " + models + " نماذج";
                info.className = "";
            }
        } catch (e) {
            info.innerHTML = "· تعذّر قراءة المساحة";
        }
    }
}

function mkdirp(path) {
    var f = fso();
    var parts = path.split("\\");
    var cur = parts[0];
    for (var i = 1; i < parts.length; i++) {
        if (!parts[i]) continue;
        cur += "\\" + parts[i];
        if (!f.FolderExists(cur)) {
            try { f.CreateFolder(cur); } catch (e) {}
        }
    }
}

function writeText(path, text) {
    var f = fso();
    var file = f.CreateTextFile(path, true, false);
    file.Write(text);
    file.Close();
}

function startInstall() {
    var boxes = document.querySelectorAll(".comp");
    var comps = [];
    var models = [];
    var hasOllama = false;
    for (var i = 0; i < boxes.length; i++) {
        if (boxes[i].checked) {
            comps.push(boxes[i].value);
            if (boxes[i].value == "ollama") hasOllama = true;
            if (boxes[i].getAttribute("data-group") == "models") models.push(boxes[i].value);
        }
    }
    var added = [];
    for (var k = 0; k < boxes.length; k++) {
        var rq = boxes[k].getAttribute("data-requires");
        if (boxes[k].checked && rq) {
            for (var q = 0; q < boxes.length; q++) {
                if (boxes[q].value == rq && !boxes[q].checked) { boxes[q].checked = true; comps.push(rq); added.push(rq); }
            }
        }
    }
    if (added.length > 0) { calc(); alert("تمت إضافة مكوّنات مطلوبة تلقائياً: " + added.join(", ")); }
    if (comps.length == 0) { alert("اختر مكوناً واحداً على الأقل."); return; }
    if (models.length > 0 && !hasOllama) { alert("لا يمكن تنزيل النماذج بدون Ollama. حدّد Ollama أو أزل النماذج."); return; }
    try {
        mkdirp(rootPath);
        var plan = { components: comps, models: models, created: new Date().toString() };
        writeText(planPath, JSON.stringify(plan));
        var cancel = rootPath + "\\cancel.flag";
        if (fso().FileExists(cancel)) fso().DeleteFile(cancel);
    } catch (e) {
        alert("تعذّر تجهيز خطة التثبيت: " + e.message);
        return;
    }
    started = true;
    finished = false;
    noStatusTicks = 0;
    showPage(4);
    document.getElementById("progMsg").innerHTML = "جارٍ بدء المثبّت...";
    document.getElementById("progDetail").innerHTML = "يتم تشغيل PowerShell في الخلفية";
    var ps = sh().ExpandEnvironmentStrings("%SystemRoot%") + "\\System32\\WindowsPowerShell\\v1.0\\powershell.exe";
    var cmd = '"' + ps + '" -NoProfile -ExecutionPolicy Bypass -WindowStyle Minimized -File "' + scriptDir + '\\install.ps1"';
    try {
        sh().Run(cmd, 7, false);
    } catch (e) {
        showError({ message: "تعذّر تشغيل المثبّت: " + e.message, logPath: logPath });
        return;
    }
    pollTimer = setInterval(pollStatus, 800);
    setTimeout(pollStatus, 1200);
}

function readUnicode(path) {
    var f = fso();
    if (!f.FileExists(path)) return null;
    try {
        var file = f.OpenTextFile(path, 1, false, -1);
        var text = file.ReadAll();
        file.Close();
        return text;
    } catch (e) {
        return null;
    }
}

function pollStatus() {
    if (!started || finished) return;
    var text = readUnicode(statusPath);
    if (!text) {
        noStatusTicks++;
        if (noStatusTicks > 20) {
            document.getElementById("progDetail").innerHTML = "في انتظار بدء PowerShell...";
        }
        return;
    }
    noStatusTicks = 0;
    var s = null;
    try { s = JSON.parse(text); } catch (e) { return; }
    lastStatus = s;
    renderStatus(s);
    if (s.state == "done") {
        finished = true;
        clearInterval(pollTimer);
        renderFinish(s);
    } else if (s.state == "error") {
        finished = true;
        clearInterval(pollTimer);
        showError(s);
    } else if (s.state == "cancelled") {
        finished = true;
        clearInterval(pollTimer);
        showError(s);
    }
}

function renderStatus(s) {
    var pct = Math.max(0, Math.min(100, parseFloat(s.percent) || 0));
    document.getElementById("pctText").innerHTML = Math.round(pct) + "<small>%</small>";
    document.getElementById("barInner").style.width = pct + "%";
    if (s.message) document.getElementById("progMsg").innerHTML = esc(s.message);
    var d = s.detail || "";
    if (d) document.getElementById("progDetail").innerHTML = esc(d);
    var jobs = s.tasks || [];
    var html = "";
    var stateAr = { pending: "بانتظار", running: "جارٍ", done: "تم", error: "فشل" };
    for (var i = 0; i < jobs.length; i++) {
        var t = jobs[i];
        var cls = t.status || "pending";
        html += '<div class="task ' + cls + '"><span class="dot"></span><div class="tinfo"><b>' + esc(t.label) + '</b><small>' + esc(t.detail || " ") + '</small></div><span class="tstate">' + (stateAr[cls] || "") + '</span></div>';
    }
    document.getElementById("taskList").innerHTML = html || '<div style="color:#8a9bab;font-size:10px;">بانتظار البدء...</div>';
    if (s.log && s.log.length) {
        document.getElementById("logBox").innerHTML = esc(s.log.join("\n"));
        var lb = document.getElementById("logBox");
        lb.scrollTop = lb.scrollHeight;
    }
    if (s.logPath) logPath = s.logPath;
}

function renderFinish(s) {
    var sum = s.summary || {};
    document.getElementById("doneModels").innerHTML = (sum.models || 0) + (sum.models_requested ? " / " + sum.models_requested : "");
    document.getElementById("doneTools").innerHTML = (sum.tools || 0) + (sum.tools_requested ? " / " + sum.tools_requested : "");
    document.getElementById("doneMcp").innerHTML = sum.mcp || 0;
    document.getElementById("doneVerified").innerHTML = (sum.verified || 0) + (sum.missing ? " / " + ((sum.verified || 0) + sum.missing) : "");
    if (sum.warnings && sum.warnings > 0) document.getElementById("finishWarn").className = "warnbox";
    else document.getElementById("finishWarn").className = "warnbox hidden";
    document.getElementById("finishPath").innerHTML = esc(s.root || rootPath);
    if (s.logPath) logPath = s.logPath;
    showPage(5);
    document.getElementById("topTitle").innerHTML = "تم بنجاح";
}

function showError(s) {
    finished = true;
    document.getElementById("errMsg").innerHTML = esc(s.detail || s.message || "حدث خطأ غير متوقع.");
    document.getElementById("errPath").innerHTML = esc(s.logPath || logPath);
    if (s.logPath) logPath = s.logPath;
    showPage(6);
    var footer = document.getElementById("footer");
    footer.className = "footer hidden";
    updateSteps(4);
}

function cancelInstall() {
    if (!started || finished) return;
    if (!confirm("هل تريد إلغاء التثبيت؟ سيتم إيقافه بعد المهمة الحالية.")) return;
    try {
        writeText(rootPath + "\\cancel.flag", "1");
        document.getElementById("progDetail").innerHTML = "جارٍ طلب الإلغاء...";
    } catch (e) {}
}

function openFolder() {
    try { sh().Run('explorer.exe "' + rootPath + '"', 1, false); } catch (e) {}
}

function openLog() {
    try {
        var p = logPath;
        if (p && fso().FileExists(p)) {
            sh().Run('notepad.exe "' + p + '"', 1, false);
        } else {
            if (!p) p = rootPath + "\\logs";
            sh().Run('explorer.exe "' + p + '"', 1, false);
        }
    } catch (e) {}
}

function openReport() {
    try {
        var p = rootPath + "\\verify-report.txt";
        if (fso().FileExists(p)) sh().Run('notepad.exe "' + p + '"', 1, false);
        else openLog();
    } catch (e) {}
}

function closeWizard() {
    try { window.close(); } catch (e) {}
}

function esc(s) {
    if (s === null || s === undefined) return "";
    return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

window.onbeforeunload = function() {
    if (started && !finished) return "التثبيت ما زال جارياً. إذا أغلقت النافذة فسيستمر في الخلفية.";
};
</script>
</body>
</html>
