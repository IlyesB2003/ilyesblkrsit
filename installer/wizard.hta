          <label class="item"><input type="checkbox" class="comp" data-group="optional" value="androidstudio" data-size="1300" onchange="calc();"><span class="ibody"><b>Android Studio</b><small>تطوير تطبيقات Android</small></span><span class="size">1.27 GB</span></label>
          <label class="item"><input type="checkbox" class="comp" data-group="optional" value="docker" data-size="2000" onchange="calc();"><span class="ibody"><b>Docker Desktop</b><small>الحاويات (يحتاج WSL2 وإعادة تشغيل)</small></span><span class="size">1.95 GB</span></label>
